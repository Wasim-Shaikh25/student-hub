# Database
DATABASE_URL=postgresql://civic_audit:secure_password_change_me@localhost:5432/civic_audit
SQLALCHEMY_ECHO=False

# JWT
SECRET_KEY=dev-secret-key-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# AWS S3 (not used in POC)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=civic-audit-evidence
AWS_REGION=us-east-1

# Redis (not used in POC)
REDIS_URL=redis://localhost:6379/0

# Email (not used in POC)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Environment
ENVIRONMENT=development
DEBUG=True

# PostGIS
POSTGIS_ENABLED=True

# Super admin (auto-created on startup)
SUPER_ADMIN_EMAIL=admin@studentshub.com
SUPER_ADMIN_MOBILE=+91-0000000000
SUPER_ADMIN_PASSWORD=admin1234

# Resolution auto-transition
RESOLVED_CONFIDENCE_THRESHOLD=75
MIN_RESOLUTION_CONFIRMATIONS=2
